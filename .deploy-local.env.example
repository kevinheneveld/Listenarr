# Personal deploy config for scripts/deploy-local.sh.
#
# Copy this file to `.deploy-local.env` (gitignored) and fill in your values.
# Host-specific values are kept out of the repo so they don't get published
# to the public fork.
#
#   cp .deploy-local.env.example .deploy-local.env
#   $EDITOR .deploy-local.env

# SSH alias from ~/.ssh/config that points at the host running the live Docker
# container. The script will run `ssh "$MEDIA_SSH" ...` for every remote step,
# so a Host entry in ~/.ssh/config with key-based auth is the cleanest setup.
MEDIA_SSH=

# IP address (or LAN-resolvable hostname) of the media host. Used for HTTP
# health checks and smoke tests run from the build machine. Required.
MEDIA_IP=

# Remote working directory on the media host where the source tree is rsynced
# before the Docker build. Optional — defaults to /root/listenarr-build/listenarr-src.
# BUILD_DIR_REMOTE=
